APP_NAME="SSC UG Admissions 2027"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ug_admissions
DB_USERNAME=ug_admissions
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Session cookie hardening (set SESSION_SECURE_COOKIE=true when served over HTTPS)
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# --- UG Admissions settings ---
CUET_PREFIX=27
CUET_REGEX="/^27[0-9]{8,13}$/"
# Staff panel URL prefix: change to something hard to guess in production
ADMIN_PATH=ssc-staff
ADMIN_OTP_ENABLED=true
ADMIN_MAX_ATTEMPTS=5
ADMIN_ATTEMPT_WINDOW=15
ADMIN_BLOCK_MINUTES=30
APPLICANT_MAX_ATTEMPTS=10
APPLICANT_ATTEMPT_WINDOW=15
APPLICANT_BLOCK_MINUTES=15
ADMIN_IDLE_MINUTES=30
ADMISSIONS_EMAIL=admissions@ststephens.edu
ADMISSIONS_PHONE=+91-11-27667271

# --- Fees (₹) ---
FEE_FIRST_COURSE=500
FEE_ADDITIONAL_COURSE=200
FEE_RESIDENCE=1000
FEE_COURSE_AFTER_PAYMENT=500
FEE_RESIDENCE_AFTER_PAYMENT=1000
# Applicants can ask us to re-check an unconfirmed payment after this many minutes
PAYMENT_STATUS_CHECK_AFTER=45
PAYMENT_RECONCILE_MAX_HOURS=72

# --- SBI ePay (values from SBI's merchant kit) ---
# "fake" shows a test payment page (blocked in production); use "sbi" for the real gateway
SBI_EPAY_DRIVER=fake
SBI_EPAY_MERCHANT_ID=
SBI_EPAY_AGGREGATOR_ID=SBIEPAY
SBI_EPAY_KEY=
SBI_EPAY_CIPHER=aes-128-ecb
SBI_EPAY_OPERATING_MODE=DOM
# Test environment: https://test.sbiepay.sbi/secure/AggregatorHostedListener and .../payagg/statusQuery/getStatusQuery
SBI_EPAY_TRANSACTION_URL=https://www.sbiepay.sbi/secure/AggregatorHostedListener
SBI_EPAY_STATUS_URL=https://www.sbiepay.sbi/payagg/statusQuery/getStatusQuery
